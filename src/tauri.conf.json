{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "sweety-ai",
  "version": "0.1.0",
  "identifier": "com.sweety.ai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SweetyAI",
        "width": 80,
        "height": 80,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}